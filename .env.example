# ── Supabase (https://supabase.com) ──────────────────────────────────────────
# Create a free project at supabase.com, run supabase_schema.sql in SQL Editor
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ── Google Gemini (free at https://aistudio.google.com) ───────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get these
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# These are set automatically from credentials.json and token.json
# For Cloud Deployments (Render / Railway), paste the raw JSON contents
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# ── Optional Settings ─────────────────────────────────────────────────────────
GMAIL_MAX_RESULTS=50       # Number of emails to fetch per run
DAILY_SYNC_LIMIT=5         # Daily max Gmail sync quota (resets at 00:00 UTC)
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR

# ── Legacy / Optional ────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID=
